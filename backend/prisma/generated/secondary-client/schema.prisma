datasource db {
  provider = "postgresql"
  url      = env("SECONDARY_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/secondary-client"
}

model ProfileAuditLog {
  id             String   @id @default(uuid())
  employeeId     String
  employeeEmail  String
  changedFields  String // JSON string or summary of changed fields e.g., ["phone", "photoUrl", "password"]
  previousValues String // JSON string of old values
  newValues      String // JSON string of new values
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())

  @@map("profile_audit_logs")
}
